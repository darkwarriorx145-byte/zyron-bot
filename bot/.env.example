# Discord Bot Configuration
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE
PREFIX=.
DEFAULT_OWNER_ID=YOUR_DISCORD_USER_ID
MAIN_ADMIN_DISCORD_ID=YOUR_DASHBOARD_ADMIN_DISCORD_USER_ID

# OpenRouter AI Guard (second opinion for anti-nuke, anti-raid and abuse)
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=recursive/flint-v1.0:free
OPENROUTER_FALLBACK_MODEL_2=openrouter/free
OPENROUTER_SITE_URL=https://zyranodes.com
OPENROUTER_APP_NAME=Zyron
AI_ENABLED=true
AI_CONFIDENCE=0.6
AI_TIMEOUT_MS=12000

# Web bridge (needed when the dashboard is on another machine, e.g. Netlify)
# Allocate BOT_API_PORT in Pterodactyl and use its public HTTPS URL.
BOT_API_ENABLED=true
BOT_API_HOST=0.0.0.0
BOT_API_PORT=4000
BOT_API_KEY=make-a-long-random-secret
BOT_API_PUBLIC_URL=https://your-bot-api-domain
DASHBOARD_URL=https://your-site.netlify.app
DASHBOARD_ORIGIN=https://your-site.netlify.app,http://localhost:3000
