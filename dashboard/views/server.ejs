  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    window.ZYRON = {
      serverId: <%- safeJson(serverId) %>,
      initialTab: <%- safeJson(initialTab) %>,
      botTokenConfigured: <%- safeJson(botTokenConfigured) %>,
      ticketButtons: <%- safeJson(settings.ticketButtons || []) %>,
      staffQuestions: <%- safeJson(settings.staffApplyQuestions || []) %>,
      ticketButtonStyles: <%- safeJson(ticketButtonStyles) %>,
      staffQuestionStyles: <%- safeJson(staffQuestionStyles) %>,
      activity: <%- safeJson(activity) %>
    };
  </script>
  <script>
    (function () {
      var Z = window.ZYRON;
      var form = document.getElementById('settingsForm');
      var saveStatus = document.getElementById('saveStatus');
      var toastEl = document.getElementById('toast');
      var ticketButtons = Array.isArray(Z.ticketButtons) ? Z.ticketButtons.slice() : [];
      var staffQuestions = Array.isArray(Z.staffQuestions) ? Z.staffQuestions.slice() : [];
      var dirty = false;
      var saving = false;

      function byId(id) { return document.getElementById(id); }
      function value(id) { var el = byId(id); return el ? el.value : ''; }
      function checked(id) { var el = byId(id); return el ? el.checked : false; }
      function escapeHtml(text) {
        return String(text == null ? '' : text)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }
      function formatDiscord(text) {
        var safe = escapeHtml(text);
        safe = safe.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        safe = safe.replace(/`(.+?)`/g, '<code>$1</code>');
        return safe.replace(/\n/g, '<br>');
      }
      function toast(message, type) {
        if (!toastEl) return;
        toastEl.textContent = message;
        toastEl.className = 'toast show ' + (type || '');
        window.clearTimeout(toastEl._timer);
        toastEl._timer = window.setTimeout(function () {
          toastEl.className = 'toast';
        }, 3600);
      }
      function markDirty() {
        dirty = true;
        if (saveStatus) {
          saveStatus.textContent = 'Unsaved changes';
          saveStatus.classList.add('dirty');
        }
      }
      function markSaved() {
        dirty = false;
        if (saveStatus) {
          saveStatus.textContent = 'Saved just now';
          saveStatus.classList.remove('dirty');
        }
      }

      function showPanel(id) {
        var panels = document.querySelectorAll('.panel[data-panel]');
        var found = false;
        panels.forEach(function (panel) {
          var active = panel.getAttribute('data-panel') === id;
          panel.classList.toggle('active', active);
          if (active) found = true;
        });
        if (!found) return;
        document.querySelectorAll('.server-nav-link[data-panel]').forEach(function (link) {
          link.classList.toggle('active', link.getAttribute('data-panel') === id);
        });
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', '#' + id);
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      document.querySelectorAll('.server-nav-link[data-panel]').forEach(function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          showPanel(link.getAttribute('data-panel'));
        });
      });
      document.querySelectorAll('[data-jump]').forEach(function (button) {
        button.addEventListener('click', function () {
          showPanel(button.getAttribute('data-jump'));
        });
      });
      window.addEventListener('hashchange', function () {
        var id = window.location.hash.replace('#', '');
        if (id) showPanel(id);
      });

      var initial = window.location.hash.replace('#', '') || Z.initialTab || 'overview';
      showPanel(initial);

      function makeInput(className, type, value, placeholder, maxLength) {
        var input = document.createElement('input');
        input.className = className || 'input';
        input.type = type || 'text';
        if (value !== undefined && value !== null) input.value = value;
        if (placeholder) input.placeholder = placeholder;
        if (maxLength) input.maxLength = maxLength;
        return input;
      }

      function makeSelect(className, values, selected) {
        var select = document.createElement('select');
        select.className = className || 'input';
        values.forEach(function (option) {
          var el = document.createElement('option');
          el.value = option.value;
          el.textContent = option.label;
          if (option.value === selected) el.selected = true;
          select.appendChild(el);
        });
        return select;
      }

      function field(label, control, hint, className) {
        var wrap = document.createElement('label');
        wrap.className = 'field ' + (className || '');
        var title = document.createElement('span');
        title.textContent = label;
        wrap.appendChild(title);
        wrap.appendChild(control);
        if (hint) {
          var small = document.createElement('small');
          small.className = 'field-hint';
          small.textContent = hint;
          wrap.appendChild(small);
        }
        return wrap;
      }

      function rowActions(onMove, onDelete) {
        var actions = document.createElement('div');
        actions.className = 'row-actions';
        var up = document.createElement('button');
        up.type = 'button';
        up.className = 'icon-btn ghost';
        up.title = 'Move up';
        up.innerHTML = '<span aria-hidden="true">↑</span>';
        up.addEventListener('click', onMove.bind(null, -1));
        var down = document.createElement('button');
        down.type = 'button';
        down.className = 'icon-btn ghost';
        down.title = 'Move down';
        down.innerHTML = '<span aria-hidden="true">↓</span>';
        down.addEventListener('click', onMove.bind(null, 1));
        var remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'icon-btn danger';
        remove.title = 'Remove';
        remove.textContent = '×';
        remove.addEventListener('click', onDelete);
        actions.appendChild(up);
        actions.appendChild(down);
        actions.appendChild(remove);
        return actions;
      }

      function renderTicketButtons() {
        var editor = byId('ticketButtonsEditor');
        var empty = byId('ticketButtonsEmpty');
        if (!editor) return;
        editor.innerHTML = '';
        if (empty) empty.style.display = ticketButtons.length ? 'none' : 'block';

        ticketButtons.forEach(function (button, index) {
          var row = document.createElement('div');
          row.className = 'dynamic-row';
          row.setAttribute('data-index', String(index));

          var head = document.createElement('div');
          head.className = 'dynamic-row-head';
          var number = document.createElement('span');
          number.className = 'row-number';
          number.textContent = String(index + 1).padStart(2, '0');
          var kind = document.createElement('span');
          kind.className = 'row-kind';
          kind.textContent = 'Ticket button';
          head.appendChild(number);
          head.appendChild(kind);
          head.appendChild(rowActions(function (direction) {
            var target = index + direction;
            if (target < 0 || target >= ticketButtons.length) return;
            var item = ticketButtons.splice(index, 1)[0];
            ticketButtons.splice(target, 0, item);
            renderTicketButtons();
            updateTicketPreview();
            markDirty();
          }, function () {
            ticketButtons.splice(index, 1);
            renderTicketButtons();
            updateTicketPreview();
            markDirty();
          }));
          row.appendChild(head);

          var grid = document.createElement('div');
          grid.className = 'row-grid';
          var labelInput = makeInput('input', 'text', button.label, 'Button label', 80);
          labelInput.addEventListener('input', function () { button.label = labelInput.value; updateTicketPreview(); markDirty(); });
          var emojiInput = makeInput('input', 'text', button.emoji, '🎫', 64);
          emojiInput.addEventListener('input', function () { button.emoji = emojiInput.value; updateTicketPreview(); markDirty(); });
          var messageInput = makeInput('input', 'text', button.message, 'Internal ticket message', 200);
          messageInput.addEventListener('input', function () { button.message = messageInput.value; markDirty(); });
          var styleSelect = makeSelect('input', [
            { value: 'primary', label: 'Blue — primary' },
            { value: 'secondary', label: 'Grey — secondary' },
            { value: 'success', label: 'Green — success' },
            { value: 'danger', label: 'Red — danger' }
          ], button.style || 'secondary');
          styleSelect.addEventListener('change', function () { button.style = styleSelect.value; updateTicketPreview(); markDirty(); });

          grid.appendChild(field('Label', labelInput, 'Shown on the button', 'span-1'));
          grid.appendChild(field('Emoji', emojiInput, 'Unicode or <:name:id>', 'span-1'));
          grid.appendChild(field('Style', styleSelect, '', 'span-1'));
          grid.appendChild(field('Internal message', messageInput, 'Opens this topic in the ticket', 'span-3'));
          row.appendChild(grid);
          editor.appendChild(row);
        });
      }

      function renderStaffQuestions() {
        var editor = byId('staffQuestionsEditor');
        if (!editor) return;
        editor.innerHTML = '';

        staffQuestions.forEach(function (question, index) {
          var row = document.createElement('div');
          row.className = 'dynamic-row';
          row.setAttribute('data-index', String(index));

          var head = document.createElement('div');
          head.className = 'dynamic-row-head';
          var number = document.createElement('span');
          number.className = 'row-number';
          number.textContent = String(index + 1).padStart(2, '0');
          var kind = document.createElement('span');
          kind.className = 'row-kind';
          kind.textContent = 'Application question';
          head.appendChild(number);
          head.appendChild(kind);
          head.appendChild(rowActions(function (direction) {
            var target = index + direction;
            if (target < 0 || target >= staffQuestions.length) return;
            var item = staffQuestions.splice(index, 1)[0];
            staffQuestions.splice(target, 0, item);
            renderStaffQuestions();
            updateStaffPreview();
            markDirty();
          }, function () {
            staffQuestions.splice(index, 1);
            renderStaffQuestions();
            updateStaffPreview();
            markDirty();
          }));
          row.appendChild(head);

          var grid = document.createElement('div');
          grid.className = 'row-grid';
          var labelInput = makeInput('input', 'text', question.label, 'Question label', 45);
          labelInput.addEventListener('input', function () { question.label = labelInput.value; updateStaffPreview(); markDirty(); });
          var placeholderInput = makeInput('input', 'text', question.placeholder, 'Placeholder text', 100);
          placeholderInput.addEventListener('input', function () { question.placeholder = placeholderInput.value; markDirty(); });
          var styleSelect = makeSelect('input', [
            { value: 'short', label: 'Short answer' },
            { value: 'paragraph', label: 'Paragraph' }
          ], question.style || 'short');
          styleSelect.addEventListener('change', function () {
            question.style = styleSelect.value;
            if (question.style === 'paragraph' && Number(question.maxLength) < 200) {
              question.maxLength = 500;
              maxInput.value = '500';
            }
            updateStaffPreview();
            markDirty();
          });
          var maxInput = makeInput('input', 'number', question.maxLength || 100, '', 4);
          maxInput.min = '1';
          maxInput.max = '1000';
          maxInput.addEventListener('input', function () { question.maxLength = Number(maxInput.value) || 1; markDirty(); });
          var required = document.createElement('input');
          required.type = 'checkbox';
          required.checked = question.required !== false;
          required.addEventListener('change', function () { question.required = required.checked; markDirty(); });
          var requiredWrap = document.createElement('label');
          requiredWrap.className = 'check-inline';
          requiredWrap.appendChild(required);
          var requiredText = document.createElement('span');
          requiredText.textContent = 'Required';
          requiredWrap.appendChild(requiredText);

          grid.appendChild(field('Label', labelInput, 'Shown in the modal', 'span-2'));
          grid.appendChild(field('Type', styleSelect, '', 'span-1'));
          grid.appendChild(field('Max length', maxInput, '1–1000', 'span-1'));
          grid.appendChild(field('Placeholder', placeholderInput, 'Optional hint', 'span-3'));
          grid.appendChild(field('Validation', requiredWrap, '', 'span-2'));
          row.appendChild(grid);
          editor.appendChild(row);
        });
      }

      function updateTicketPreview() {
        var title = byId('ticketPreviewTitle');
        var description = byId('ticketPreviewDescription');
        var footer = byId('ticketPreviewFooter');
        var buttons = byId('ticketPreviewButtons');
        if (!title) return;

        var descriptionText = value('ticketPanelDescription');
        var buttonLines = ticketButtons.map(function (button) {
          return '• ' + (button.emoji ? button.emoji + ' ' : '') + '**' + (button.label || 'Button') + '** — ' + (button.message || '');
        }).join('\n');
        descriptionText = descriptionText.split('{{buttons}}').join(buttonLines);

        title.textContent = value('ticketPanelTitle') || 'Ticket panel';
        description.innerHTML = formatDiscord(descriptionText);
        footer.textContent = value('ticketPanelFooter') || '';
        buttons.innerHTML = '';

        var allButtons = [{
          label: value('ticketCreateLabel') || 'Create Ticket',
          emoji: value('ticketCreateEmoji') || '🎫',
          style: 'primary'
        }].concat(ticketButtons);

        allButtons.forEach(function (button) {
          var chip = document.createElement('span');
          chip.className = 'discord-btn ' + (button.style || 'secondary');
          var emoji = document.createElement('span');
          emoji.textContent = button.emoji || '';
          var label = document.createElement('span');
          label.textContent = button.label || 'Button';
          chip.appendChild(emoji);
          chip.appendChild(label);
          buttons.appendChild(chip);
        });
      }

      function updateStaffPreview() {
        var title = byId('staffPreviewTitle');
        var description = byId('staffPreviewDescription');
        var footer = byId('staffPreviewFooter');
        var buttons = byId('staffPreviewButtons');
        var form = byId('staffPreviewForm');
        if (!title) return;

        title.textContent = value('staffApplyPanelTitle') || 'Staff applications';
        description.innerHTML = formatDiscord(value('staffApplyPanelDescription'));
        footer.textContent = value('staffApplyPanelFooter') || '';
        buttons.innerHTML = '';
        var chip = document.createElement('span');
        chip.className = 'discord-btn success';
        var emoji = document.createElement('span');
        emoji.textContent = value('staffApplyButtonEmoji') || '📝';
        var label = document.createElement('span');
        label.textContent = value('staffApplyButtonLabel') || 'Apply Now';
        chip.appendChild(emoji);
        chip.appendChild(label);
        buttons.appendChild(chip);

        form.innerHTML = '';
        staffQuestions.forEach(function (question, index) {
          var item = document.createElement('div');
          item.className = 'preview-question';
          var number = document.createElement('span');
          number.className = 'preview-question-number';
          number.textContent = String(index + 1);
          var copy = document.createElement('span');
          var strong = document.createElement('strong');
          strong.textContent = question.label || 'Question ' + (index + 1);
          var small = document.createElement('small');
          small.textContent = (question.style === 'paragraph' ? 'Paragraph' : 'Short answer') +
            ' · max ' + (question.maxLength || 100) +
            (question.required === false ? ' · optional' : ' · required');
          copy.appendChild(strong);
          copy.appendChild(small);
          item.appendChild(number);
          item.appendChild(copy);
          form.appendChild(item);
        });
      }

      function collectPayload() {
        var payload = {
          prefix: value('prefix'),
          punishment: value('punishment') || value('punishmentSettings'),
          raidPunishment: value('raidPunishment'),
          antiNukeEnabled: checked('antiNukeEnabled'),
          aiEnabled: checked('aiEnabled'),
          aiScanMessages: checked('aiScanMessages'),
          aiModel: value('aiModel'),
          aiConfidence: value('aiConfidence'),
          aiAction: value('aiAction'),
          economyDaily: value('economyDaily'),
          economyInvite: value('economyInvite'),
          logChannel: value('logChannel'),
          autoRoleId: value('autoRoleId'),
          autoRoleBotId: value('autoRoleBotId'),
          boosterRoleId: value('boosterRoleId'),
          ticketPanelChannel: value('ticketPanelChannel'),
          ticketStaffRole: value('ticketStaffRole'),
          ticketStaffRoles: value('ticketStaffRoles').split(/[,\s]+/).filter(Boolean),
          ticketNamePattern: value('ticketNamePattern'),
          ticketAiEnabled: value('ticketAiEnabled') === 'true',
          ticketCategory: value('ticketCategory'),
          ticketLogChannel: value('ticketLogChannel'),
          ticketPanelTitle: value('ticketPanelTitle'),
          ticketPanelDescription: value('ticketPanelDescription'),
          ticketPanelFooter: value('ticketPanelFooter'),
          ticketCreateLabel: value('ticketCreateLabel'),
          ticketCreateEmoji: value('ticketCreateEmoji'),
          ticketButtons: ticketButtons,
          applicationChannel: value('applicationChannel'),
          staffApplyAcceptRole: value('staffApplyAcceptRole'),
          staffApplyAcceptRoles: value('staffApplyAcceptRoles').split(/[,\s]+/).filter(Boolean),
          appealInviteChannel: value('appealInviteChannel'),
          warningKickThreshold: value('warningKickThreshold'),
          staffApplyPanelTitle: value('staffApplyPanelTitle'),
          staffApplyPanelDescription: value('staffApplyPanelDescription'),
          staffApplyPanelFooter: value('staffApplyPanelFooter'),
          staffApplyButtonLabel: value('staffApplyButtonLabel'),
          staffApplyButtonEmoji: value('staffApplyButtonEmoji'),
          staffApplyModalTitle: value('staffApplyModalTitle'),
          staffApplyAcceptMessage: value('staffApplyAcceptMessage'),
          staffApplyDenyMessage: value('staffApplyDenyMessage'),
          staffApplyQuestions: staffQuestions,
          verificationEnabled: checked('verifyEnabled'),
          verificationChannel: value('verifyChannel'),
          verificationRole: value('verifyRole'),
          verificationLogChannel: value('verifyLog'),
          verificationMode: value('verifyMode'),
          verificationRules: value('verifyRules'),
          maintenanceMessage: value('maintenanceMessage'),
          maintenanceAllowedRoles: value('maintenanceRoles').split(/[,\s]+/).filter(Boolean),
          vouchLogChannel: value('vouchChannel'),
          feedbackChannel: value('feedbackChannel'),
          inviteLogChannel: value('inviteLogChannel'),
          nicknameLogChannel: value('nicknameLogChannel'),
          dmWarnings: checked('dmWarnings'),
          dmSecurity: checked('dmSecurity'),
          dmTicketUpdates: checked('dmTicketUpdates'),
          dmFeedback: checked('dmFeedback'),
          ticketRatingsEnabled: checked('ticketRatingsEnabled'),
          ticketPriorityEnabled: checked('ticketPriorityEnabled'),
          ticketPriorities: value('ticketPriorities').split(',').map(function (item) { return item.trim(); }).filter(Boolean),
          bannedNickPatterns: value('nickPatterns').split('\n').map(function (item) { return item.trim(); }).filter(Boolean),
          features: {}
        };
        document.querySelectorAll('.feature-toggle[data-feature]').forEach(function (input) {
          payload.features[input.getAttribute('data-feature')] = input.checked;
        });
        return payload;
      }

      function setSaving(state) {
        saving = state;
        document.querySelectorAll('[data-save], [data-publish]').forEach(function (button) {
          button.disabled = state;
        });
      }

      async function saveSettings() {
        if (saving) return false;
        setSaving(true);
        try {
          var response = await fetch('/api/server/' + Z.serverId + '/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(collectPayload())
          });
          var data = await response.json().catch(function () { return {}; });
          if (!response.ok || !data.ok) throw new Error(data.error || 'Could not save settings.');
          markSaved();
          toast('Settings saved', 'success');
          return true;
        } catch (error) {
          toast(error.message || 'Could not save settings.', 'error');
          return false;
        } finally {
          setSaving(false);
        }
      }

      async function publishPanel(type) {
        if (!Z.botTokenConfigured) {
          toast('Add BOT_TOKEN to the dashboard .env to publish panels here.', 'error');
          return;
        }
        var saved = await saveSettings();
        if (!saved) return;
        setSaving(true);
        try {
          var channelId = type === 'ticket' ? value('ticketPanelChannel') : value('applicationChannel');
          var response = await fetch('/api/server/' + Z.serverId + '/' + type + '/panel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ channelId: channelId })
          });
          var data = await response.json().catch(function () { return {}; });
          if (!response.ok || !data.ok) throw new Error(data.error || 'Could not publish the panel.');
          toast('Panel published to Discord', 'success');
        } catch (error) {
          toast(error.message || 'Could not publish the panel.', 'error');
        } finally {
          setSaving(false);
        }
      }

      document.querySelectorAll('[data-save]').forEach(function (button) {
        button.addEventListener('click', saveSettings);
      });
      document.querySelectorAll('[data-publish]').forEach(function (button) {
        button.addEventListener('click', function () { publishPanel(button.getAttribute('data-publish')); });
      });

      document.querySelectorAll('[data-appeal-action]').forEach(function (button) {
        button.addEventListener('click', async function () {
          var action = button.getAttribute('data-appeal-action');
          var caseId = button.getAttribute('data-case-id');
          if (!caseId) return;
          button.disabled = true;
          try {
            var response = await fetch('/api/server/' + Z.serverId + '/appeal/' + encodeURIComponent(caseId), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: action })
            });
            var data = await response.json().catch(function () { return {}; });
            if (!response.ok || !data.ok) throw new Error(data.error || 'Could not review the appeal.');
            toast(action === 'approve' ? 'Appeal approved - DM with invite sent' : 'Appeal denied', 'success');
            setTimeout(function () { window.location.reload(); }, 900);
          } catch (error) {
            toast(error.message || 'Could not review the appeal.', 'error');
            button.disabled = false;
          }
        });
      });

      document.querySelectorAll('[data-staff-action]').forEach(function (button) {
        button.addEventListener('click', async function () {
          var action = button.getAttribute('data-staff-action');
          var userId = button.getAttribute('data-staff-user');
          var roleInput = byId('staffRole-' + userId);
          var roleId = roleInput ? roleInput.value.trim() : '';
          if (action !== 'remove' && !roleId) {
            toast('Enter the staff role ID first.', 'error');
            if (roleInput) roleInput.focus();
            return;
          }
          button.disabled = true;
          try {
            var response = await fetch('/api/server/' + Z.serverId + '/staff/action', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: action, userId: userId, roleId: roleId })
            });
            var data = await response.json().catch(function () { return {}; });
            if (!response.ok || !data.ok) throw new Error(data.error || 'Could not update the staff member.');
            toast('Staff action applied', 'success');
          } catch (error) {
            toast(error.message || 'Could not update the staff member.', 'error');
          } finally {
            button.disabled = false;
          }
        });
      });


      if (byId('addTicketButton')) {
        byId('addTicketButton').addEventListener('click', function () {
          if (ticketButtons.length >= 9) {
            toast('Discord panels support up to 9 custom buttons.', 'error');
            return;
          }
          ticketButtons.push({ label: 'New button', emoji: '🎫', message: 'Tell us how we can help', style: 'secondary' });
          renderTicketButtons();
          updateTicketPreview();
          markDirty();
        });
      }

      if (byId('addStaffQuestion')) {
        byId('addStaffQuestion').addEventListener('click', function () {
          if (staffQuestions.length >= 5) {
            toast('Discord modals support up to 5 questions.', 'error');
            return;
          }
          staffQuestions.push({ label: 'New question', placeholder: 'Type your answer', style: 'short', required: true, maxLength: 100 });
          renderStaffQuestions();
          updateStaffPreview();
          markDirty();
        });
      }

      ['ticketPanelTitle', 'ticketPanelDescription', 'ticketPanelFooter', 'ticketCreateLabel', 'ticketCreateEmoji'].forEach(function (id) {
        var el = byId(id);
        if (el) el.addEventListener('input', updateTicketPreview);
      });
      ['staffApplyPanelTitle', 'staffApplyPanelDescription', 'staffApplyPanelFooter', 'staffApplyButtonLabel', 'staffApplyButtonEmoji'].forEach(function (id) {
        var el = byId(id);
        if (el) el.addEventListener('input', updateStaffPreview);
      });

      var confidence = byId('aiConfidence');
      if (confidence) {
        confidence.addEventListener('input', function () {
          if (byId('aiConfidenceValue')) byId('aiConfidenceValue').textContent = Math.round(Number(confidence.value) * 100) + '%';
        });
      }

      var punishmentMain = byId('punishment');
      var punishmentMirror = byId('punishmentSettings');
      if (punishmentMain && punishmentMirror) {
        punishmentMain.addEventListener('change', function () { punishmentMirror.value = punishmentMain.value; });
        punishmentMirror.addEventListener('change', function () { punishmentMain.value = punishmentMirror.value; });
      }

      if (byId('aiTestBtn')) {
        byId('aiTestBtn').addEventListener('click', async function () {
          var text = value('aiTestText').trim();
          var result = byId('aiTestResult');
          if (!text) {
            toast('Enter a message to test.', 'error');
            return;
          }
          byId('aiTestBtn').disabled = true;
          result.innerHTML = '<div class="ai-result muted">Thinking…</div>';
          try {
            var response = await fetch('/api/ai/test', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ serverId: Z.serverId, text: text })
            });
            var data = await response.json().catch(function () { return {}; });
            result.innerHTML = '';
            var card = document.createElement('div');
            card.className = 'ai-result ' + (data.ok ? 'ok' : 'bad');
            var title = document.createElement('strong');
            title.textContent = data.ok ? ((data.verdict || 'uncertain') + ' · ' + (data.action || 'none')) : 'AI test failed';
            var reason = document.createElement('p');
            reason.textContent = data.ok
              ? 'Confidence ' + Math.round(Number(data.confidence || 0) * 100) + '% · ' + (data.reason || 'No reason returned.')
              : (data.error || 'No response.');
            card.appendChild(title);
            card.appendChild(reason);
            result.appendChild(card);
          } catch (error) {
            result.innerHTML = '';
            var card = document.createElement('div');
            card.className = 'ai-result bad';
            card.textContent = error.message || 'AI test failed.';
            result.appendChild(card);
          } finally {
            byId('aiTestBtn').disabled = false;
          }
        });
      }

      form.addEventListener('input', markDirty);
      form.addEventListener('change', markDirty);
      form.addEventListener('submit', function (event) { event.preventDefault(); });
      window.addEventListener('beforeunload', function (event) {
        if (!dirty) return;
        event.preventDefault();
        event.returnValue = '';
      });

      renderTicketButtons();
      renderStaffQuestions();
      updateTicketPreview();
      updateStaffPreview();
    })();
  </script>
  <script>
    (function () {
      var Z = window.ZYRON || {};
      var serverId = Z.serverId;
      var activity = Z.activity || {};
      var toastEl = document.getElementById('toast');
      var customCommands = Array.isArray(activity.customCommands) ? activity.customCommands.slice() : [];

      function byId(id) { return document.getElementById(id); }
      function val(id) { var el = byId(id); return el ? el.value : ''; }
      function checked(id) { var el = byId(id); return el ? el.checked : false; }
      function splitIds(text) {
        return String(text || '').split(',').map(function (part) { return part.trim(); }).filter(function (part) {
          return /^\d{15,25}$/.test(part);
        });
      }
      function escapeHtml(text) {
        return String(text == null ? '' : text)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }
      function toast(message, type) {
        if (!toastEl) return;
        toastEl.textContent = message;
        toastEl.className = 'toast show ' + (type || '');
        window.clearTimeout(toastEl._timer);
        toastEl._timer = window.setTimeout(function () { toastEl.className = 'toast'; }, 3600);
      }
      function api(path, body, method) {
        return fetch('/api/server/' + encodeURIComponent(serverId) + path, {
          method: method || 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: body === undefined ? undefined : JSON.stringify(body)
        }).then(function (response) {
          return response.json().catch(function () { return {}; }).then(function (data) {
            if (!response.ok || data.ok === false) throw new Error(data.error || ('Request failed (' + response.status + ')'));
            return data;
          });
        });
      }

      function renderCustomCommands() {
        var list = byId('customCommandsList');
        if (!list) return;
        list.innerHTML = '';
        if (customCommands.length === 0) {
          list.innerHTML = '<div class="empty-inline">No custom commands yet.</div>';
          return;
        }
        customCommands.forEach(function (command) {
          var row = document.createElement('div');
          row.className = 'data-row';
          var info = document.createElement('span');
          info.innerHTML = '<strong>.' + escapeHtml(command.name) + '</strong><small>' +
            escapeHtml(command.type) + ' &middot; ' + (command.uses || 0) + ' uses' +
            (command.cooldown ? ' &middot; ' + command.cooldown + 's cooldown' : '') + '</small>';
          var actions = document.createElement('span');
          actions.className = 'row-actions';
          var edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'btn btn-ghost btn-sm';
          edit.textContent = 'Edit';
          edit.addEventListener('click', function () { editCommand(command); });
          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'btn btn-ghost btn-sm';
          remove.textContent = 'Delete';
          remove.addEventListener('click', function () {
            if (!window.confirm('Delete .' + command.name + '?')) return;
            api('/custom-command', { deleteId: command.id }).then(function () {
              toast('Command deleted.', 'success');
              window.setTimeout(function () { window.location.reload(); }, 700);
            }).catch(function (err) { toast(err.message, 'error'); });
          });
          actions.appendChild(edit);
          actions.appendChild(remove);
          row.appendChild(info);
          row.appendChild(actions);
          list.appendChild(row);
        });
      }

      function editCommand(command) {
        byId('ccEditing').value = command.id;
        byId('ccName').value = command.name;
        byId('ccName').readOnly = true;
        byId('ccType').value = command.type || 'text';
        byId('ccCooldown').value = command.cooldown || 0;
        byId('ccRoles').value = (command.allowedRoles || []).join(', ');
        byId('ccResponse').value = command.response || '';
        var embed = command.embed || {};
        byId('ccEmbedTitle').value = embed.title || '';
        byId('ccEmbedColor').value = embed.color || '#5865F2';
        byId('ccEmbedDescription').value = embed.description || '';
        updatePreview();
      }

      function resetCommandForm() {
        byId('ccEditing').value = '';
        byId('ccName').value = '';
        byId('ccName').readOnly = false;
        byId('ccType').value = 'text';
        byId('ccCooldown').value = 0;
        byId('ccRoles').value = '';
        byId('ccResponse').value = '';
        byId('ccEmbedTitle').value = '';
        byId('ccEmbedColor').value = '#5865F2';
        byId('ccEmbedDescription').value = '';
        updatePreview();
      }

      function updatePreview() {
        var body = byId('ccPreviewBody');
        if (!body) return;
        var type = val('ccType');
        var response = val('ccResponse');
        var title = val('ccEmbedTitle');
        var description = val('ccEmbedDescription');
        var color = val('ccEmbedColor') || '#5865F2';
        if (type === 'embed') {
          body.innerHTML = '<div class="cc-embed" style="border-left:4px solid ' + escapeHtml(color) + '">' +
            (title ? '<strong>' + escapeHtml(title) + '</strong>' : '') +
            '<p>' + escapeHtml(description || response || 'Embed description preview') + '</p></div>';
        } else {
          body.innerHTML = '<p>' + escapeHtml(response || 'Your command response preview') + '</p>';
        }
      }

      function saveCustomCommand() {
        var name = val('ccName').trim().toLowerCase().replace(/[^a-z0-9-_]/g, '');
        if (!name) { toast('Enter a command name.', 'error'); return; }
        var type = val('ccType');
        var command = {
          name: name,
          type: type,
          response: val('ccResponse'),
          cooldown: Number(val('ccCooldown')) || 0,
          allowedRoles: splitIds(val('ccRoles')),
          embed: type === 'embed' ? {
            title: val('ccEmbedTitle'),
            description: val('ccEmbedDescription'),
            color: val('ccEmbedColor') || '#5865F2'
          } : null
        };
        var editing = val('ccEditing');
        var payload = editing ? { updateId: editing, command: command } : { command: command };
        api('/custom-command', payload).then(function () {
          toast(editing ? 'Command updated.' : 'Command created.', 'success');
          window.setTimeout(function () { window.location.reload(); }, 700);
        }).catch(function (err) { toast(err.message, 'error'); });
      }

      function renderReactionRoles() {
        var list = byId('reactionRolesList');
        if (!list) return;
        var panels = Array.isArray(activity.reactionRoles) ? activity.reactionRoles : [];
        list.innerHTML = '';
        if (panels.length === 0) {
          list.innerHTML = '<div class="empty-inline">No role panels yet.</div>';
          return;
        }
        panels.forEach(function (panel) {
          var row = document.createElement('div');
          row.className = 'data-row';
          var info = document.createElement('span');
          info.innerHTML = '<strong>' + escapeHtml(panel.label || panel.type) + '</strong><small>Role ' +
            escapeHtml(panel.roleId) + ' &middot; ' + escapeHtml(panel.type) + '</small>';
          var actions = document.createElement('span');
          actions.className = 'row-actions';
          var publish = document.createElement('button');
          publish.type = 'button';
          publish.className = 'btn btn-ghost btn-sm';
          publish.textContent = 'Republish';
          publish.addEventListener('click', function () {
            api('/reaction-role', { publishId: panel.id }).then(function () {
              toast('Panel republished.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          });
          var remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'btn btn-ghost btn-sm';
          remove.textContent = 'Delete';
          remove.addEventListener('click', function () {
            if (!window.confirm('Delete this role panel?')) return;
            api('/reaction-role', { deleteId: panel.id }).then(function () {
              toast('Panel deleted.', 'success');
              window.setTimeout(function () { window.location.reload(); }, 700);
            }).catch(function (err) { toast(err.message, 'error'); });
          });
          actions.appendChild(publish);
          actions.appendChild(remove);
          row.appendChild(info);
          row.appendChild(actions);
          list.appendChild(row);
        });
      }

      function renderLeaderboards() {
        var vouchList = byId('vouchLeaderboard');
        if (vouchList) {
          var leaderboard = (activity.vouchStats && activity.vouchStats.leaderboard) || [];
          vouchList.innerHTML = leaderboard.length ? leaderboard.map(function (entry, index) {
            return '<div class="data-row"><span><strong>#' + (index + 1) + ' &lt;@' + escapeHtml(entry.userId) + '&gt;</strong>' +
              '<small>' + (entry.count || 0) + ' vouches &middot; avg ' + (entry.avg || 0) + '/5</small></span></div>';
          }).join('') : '<div class="empty-inline">No vouches yet. Members can use .vouch @user.</div>';
        }
        var inviteList = byId('inviteLeaderboard');
        if (inviteList) {
          var invites = Array.isArray(activity.inviteLeaderboard) ? activity.inviteLeaderboard : [];
          inviteList.innerHTML = invites.length ? invites.map(function (entry, index) {
            return '<div class="data-row"><span><strong>#' + (index + 1) + ' &lt;@' + escapeHtml(entry.userId) + '&gt;</strong>' +
              '<small>' + (entry.amount || 0) + ' invites</small></span></div>';
          }).join('') : '<div class="empty-inline">No tracked invites yet.</div>';
        }
      }

      function populatePickers() {
        var channelPickers = document.querySelectorAll('[data-channel-picker]');
        var rolePickers = document.querySelectorAll('[data-role-picker]');
        if (channelPickers.length === 0 && rolePickers.length === 0) return;
        api('/picker', undefined, 'GET').then(function (data) {
          var channels = data.channels || [];
          var roles = data.roles || [];
          channelPickers.forEach(function (select) {
            var selected = select.getAttribute('data-selected') || select.value || '';
            select.innerHTML = '<option value="">— None —</option>' + channels.map(function (channel) {
              var label = (channel.type === 4 ? '📁 ' : (channel.type === 2 ? '🔊 ' : '# ')) + channel.name;
              return '<option value="' + escapeHtml(channel.id) + '">' + escapeHtml(label) + '</option>';
            }).join('');
            if (selected) select.value = selected;
          });
          rolePickers.forEach(function (select) {
            var selected = select.getAttribute('data-selected') || select.value || '';
            select.innerHTML = '<option value="">— None —</option>' + roles.map(function (role) {
              return '<option value="' + escapeHtml(role.id) + '">' + escapeHtml(role.name) + '</option>';
            }).join('');
            if (selected) select.value = selected;
          });
        }).catch(function (err) {
          toast('Could not load channels and roles: ' + err.message, 'error');
        });
      }

      document.querySelectorAll('[data-mod-action]').forEach(function (button) {
        button.addEventListener('click', function () {
          var action = button.getAttribute('data-mod-action');
          if (action === 'save-verification') {
            api('/verification', {
              channelId: val('verifyChannel'),
              roleId: val('verifyRole'),
              logChannelId: val('verifyLog'),
              rules: val('verifyRules'),
              mode: val('verifyMode'),
              enabled: checked('verifyEnabled')
            }).then(function () {
              toast('Verification saved and panel sent.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'maintenance-on') {
            if (!window.confirm('Hide every channel and enable maintenance mode?')) return;
            api('/maintenance', {
              enabled: true,
              message: val('maintenanceMessage'),
              allowedRoles: splitIds(val('maintenanceRoles'))
            }).then(function () {
              toast('Maintenance mode enabled.', 'success');
              window.setTimeout(function () { window.location.reload(); }, 900);
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'maintenance-off') {
            api('/maintenance', { enabled: false }).then(function () {
              toast('Maintenance mode disabled.', 'success');
              window.setTimeout(function () { window.location.reload(); }, 900);
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'maintenance-announce') {
            api('/maintenance', { announce: val('maintenanceAnnounce') }).then(function () {
              toast('Announcement sent.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'custom-command-save') {
            saveCustomCommand();
          } else if (action === 'custom-command-reset') {
            resetCommandForm();
          } else if (action === 'reaction-role-save') {
            api('/reaction-role', {
              channelId: val('rrChannel'),
              roleId: val('rrRole'),
              type: val('rrType'),
              label: val('rrLabel'),
              emoji: val('rrEmoji'),
              description: val('rrDescription'),
              maxRoles: Number(val('rrMax')) || 0
            }).then(function () {
              toast('Role panel published.', 'success');
              window.setTimeout(function () { window.location.reload(); }, 800);
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'purge') {
            if (!window.confirm('Delete matching messages in this channel?')) return;
            api('/purge', {
              channelId: val('purgeChannel'),
              options: {
                limit: Number(val('purgeLimit')) || 100,
                userId: val('purgeUser').trim() || undefined,
                contains: val('purgeContains').trim() || undefined,
                bot: checked('purgeBots'),
                links: checked('purgeLinks'),
                invites: checked('purgeInvites'),
                images: checked('purgeImages'),
                embeds: checked('purgeEmbeds'),
                pinned: checked('purgePinned')
              }
            }).then(function (data) {
              toast('Purged ' + (data.deleted || 0) + ' messages.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'nickname-set') {
            api('/nickname', { userId: val('nickUser'), nickname: val('nickValue') }).then(function () {
              toast('Nickname updated.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'nickname-reset') {
            api('/nickname', { userId: val('nickUser'), reset: true }).then(function () {
              toast('Nickname reset.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          } else if (action === 'notifications-save') {
            api('/update', {
              vouchLogChannel: val('vouchChannel') || null,
              feedbackChannel: val('feedbackChannel') || null,
              inviteLogChannel: val('inviteLogChannel') || null,
              nicknameLogChannel: val('nicknameLogChannel') || null,
              dmWarnings: checked('dmWarnings'),
              dmSecurity: checked('dmSecurity'),
              dmTicketUpdates: checked('dmTicketUpdates'),
              dmFeedback: checked('dmFeedback'),
              ticketRatingsEnabled: checked('ticketRatingsEnabled'),
              ticketPriorityEnabled: checked('ticketPriorityEnabled'),
              ticketPriorities: String(val('ticketPriorities') || '').split(',').map(function (p) { return p.trim(); }).filter(Boolean),
              bannedNickPatterns: String(val('nickPatterns') || '').split('\n').map(function (p) { return p.trim(); }).filter(Boolean)
            }).then(function () {
              toast('Notification settings saved.', 'success');
            }).catch(function (err) { toast(err.message, 'error'); });
          }
        });
      });

      ['ccResponse', 'ccType', 'ccEmbedTitle', 'ccEmbedDescription', 'ccEmbedColor'].forEach(function (id) {
        var el = byId(id);
        if (el) el.addEventListener('input', updatePreview);
        if (el) el.addEventListener('change', updatePreview);
      });

      renderCustomCommands();
      renderReactionRoles();
      renderLeaderboards();
      updatePreview();
      populatePickers();
    })();
  </script>
</body>
</html>
