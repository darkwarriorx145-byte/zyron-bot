            <div class="row-actions">
              <button type="button" class="btn btn-primary btn-sm" data-mod-action="save-verification">Save &amp; send panel</button>
            </div>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'tool', size: 18 }) %></span>
                <div>
                  <h3>Maintenance mode</h3>
                  <p class="muted">Hide every channel, keep staff roles visible and post a public notice.</p>
                </div>
              </div>
            </div>
            <label class="field span-2">
              <span>Maintenance message</span>
              <textarea class="input" id="maintenanceMessage" rows="3" maxlength="2000"><%= settings.maintenanceMessage || 'The server is currently under maintenance. Please check back later.' %></textarea>
            </label>
            <label class="field span-2">
              <span>Staff role IDs allowed to see channels (comma separated)</span>
              <input class="input" id="maintenanceRoles" type="text" value="<%= (settings.maintenanceAllowedRoles || []).join(', ') %>" placeholder="123456789012345678, 987654321098765432">
            </label>
            <label class="field span-2">
              <span>Announcement text</span>
              <textarea class="input" id="maintenanceAnnounce" rows="2" maxlength="2000" placeholder="Optional update for the maintenance channel."></textarea>
            </label>
            <div class="row-actions">
              <button type="button" class="btn btn-primary btn-sm" data-mod-action="maintenance-on">Enable maintenance</button>
              <button type="button" class="btn btn-ghost btn-sm" data-mod-action="maintenance-off">Disable</button>
              <button type="button" class="btn btn-ghost btn-sm" data-mod-action="maintenance-announce">Send update</button>
            </div>
          </div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'terminal', size: 18 }) %></span>
