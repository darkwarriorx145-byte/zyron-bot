                <option value="button" <%= settings.verificationMode === 'button' ? 'selected' : '' %>>Panel button</option>
                <option value="dm" <%= settings.verificationMode === 'dm' ? 'selected' : '' %>>DM on join</option>
                <option value="channel" <%= settings.verificationMode === 'channel' ? 'selected' : '' %>>Channel only</option>
              </select>
            </label>
            <label class="field span-2">
              <span>Rules text</span>
              <textarea class="input" id="verifyRules" rows="5" maxlength="4000" placeholder="1. Be respectful..."><%= settings.verificationRules || '' %></textarea>
            </label>
            <label class="field span-2">
              <span class="checkbox-row"><input type="checkbox" id="verifyEnabled" <%= settings.verificationEnabled ? 'checked' : '' %>> Verification enabled</span>
