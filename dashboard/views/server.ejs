<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zyron — <%= serverName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/glass-core.css">
  <link rel="stylesheet" href="/css/glass-server.css">
  <link rel="stylesheet" href="/css/glass-responsive.css">
</head>
<%
  function safeJson(value) {
    return JSON.stringify(value)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026');
  }
  var featureEnabledCount = Object.keys(settings.features || {}).filter(function (key) {
    return settings.features[key];
  }).length;
  var securityFeatures = featureCatalog.filter(function (feature) { return feature.group === 'security'; });
  var chatFeatures = featureCatalog.filter(function (feature) { return feature.group === 'chat'; });
  var recoveryFeatures = featureCatalog.filter(function (feature) { return feature.group === 'recovery'; });
%>
<body class="app server-page">
  <%- include('partials/notch', { notchLabel: serverName, notchMeta: 'Server control room' }) %>
  <%- include('partials/server-sidebar', { activeTab: initialTab }) %>

  <main class="main server-main">
    <header class="server-topbar">
      <div class="server-topbar-title">
        <span class="eyebrow">Server control room</span>
        <h1><%= serverName %></h1>
        <div class="server-topbar-meta">
          <span class="status-dot"></span>
          <span>Zyron connected</span>
          <span class="dot-sep">·</span>
          <span>Prefix <code><%= settings.prefix %></code></span>
          <% if (botApiOnline === false) { %>
            <span class="dot-sep">·</span>
            <span class="text-warn">Bot API offline — using local DB</span>
          <% } %>
        </div>
      </div>
      <div class="topbar-actions">
        <span id="saveStatus" class="save-status">All changes saved</span>
        <button type="button" class="btn btn-ghost" data-save>
          <%- include('partials/icon', { name: 'save', size: 16 }) %>
          Save
        </button>
        <a class="btn btn-ghost" href="/dashboard">Exit</a>
      </div>
    </header>

    <form id="settingsForm" class="settings-form" autocomplete="off" novalidate>
      <section class="panel active" data-panel="overview" id="panel-overview">
        <div class="panel-head">
          <div>
            <span class="eyebrow">At a glance</span>
            <h2>Overview</h2>
            <p class="muted">A clean pulse on protection, community tools and the settings behind them.</p>
          </div>
          <span class="badge badge-success"><%= featureEnabledCount %> guards active</span>
        </div>

        <div class="overview-hero glass">
          <div class="overview-hero-main">
            <span class="server-avatar xlarge">
              <% if (serverIcon) { %>
                <img src="<%= serverIcon %>" alt="">
              <% } else { %>
                <%- include('partials/icon', { name: 'server', size: 30 }) %>
              <% } %>
            </span>
            <div>
              <span class="eyebrow">Workspace</span>
              <h2><%= serverName %></h2>
              <p class="muted">Every change below is stored only for this server.</p>
            </div>
          </div>
          <div class="overview-hero-stats">
            <div class="mini-stat"><strong><%= featureEnabledCount %></strong><small>Active guards</small></div>
            <div class="mini-stat"><strong><%= settings.ticketButtons.length %></strong><small>Ticket buttons</small></div>
            <div class="mini-stat"><strong><%= settings.staffApplyQuestions.length %></strong><small>Application questions</small></div>
            <div class="mini-stat"><strong><%= settings.economyDaily %></strong><small>Daily coins</small></div>
          </div>
        </div>

        <div class="status-tile-grid">
          <button type="button" class="status-tile glass" data-jump="antinuke">
            <span class="status-tile-icon blue"><%- include('partials/icon', { name: 'shield-check', size: 20 }) %></span>
            <span class="status-tile-copy">
              <small>Anti-Nuke</small>
              <strong><%= settings.antiNukeEnabled ? 'Enabled' : 'Disabled' %></strong>
            </span>
            <span class="badge <%= settings.antiNukeEnabled ? 'badge-success' : 'badge-muted' %>"><%= settings.antiNukeEnabled ? 'Live' : 'Off' %></span>
          </button>
          <button type="button" class="status-tile glass" data-jump="antiraid">
            <span class="status-tile-icon violet"><%- include('partials/icon', { name: 'zap', size: 20 }) %></span>
            <span class="status-tile-copy">
              <small>Anti-Raid</small>
              <strong><%= settings.features.antiRaid ? 'Watching joins' : 'Disabled' %></strong>
            </span>
            <span class="badge <%= settings.features.antiRaid ? 'badge-success' : 'badge-muted' %>"><%= settings.features.antiRaid ? 'Live' : 'Off' %></span>
          </button>
          <button type="button" class="status-tile glass" data-jump="ai">
            <span class="status-tile-icon amber"><%- include('partials/icon', { name: 'brain', size: 20 }) %></span>
            <span class="status-tile-copy">
              <small>AI Guard</small>
              <strong><%= settings.aiEnabled ? 'Second opinion' : 'Disabled' %></strong>
            </span>
            <span class="badge <%= settings.aiEnabled ? 'badge-success' : 'badge-muted' %>"><%= settings.aiEnabled ? 'Ready' : 'Off' %></span>
          </button>
          <button type="button" class="status-tile glass" data-jump="tickets">
            <span class="status-tile-icon green"><%- include('partials/icon', { name: 'ticket', size: 20 }) %></span>
            <span class="status-tile-copy">
              <small>Tickets</small>
              <strong><%= settings.ticketPanelChannel ? 'Panel connected' : 'Panel not sent' %></strong>
            </span>
            <span class="badge <%= settings.ticketPanelChannel ? 'badge-success' : 'badge-muted' %>"><%= settings.ticketPanelChannel ? 'Ready' : 'Setup' %></span>
          </button>
        </div>

        <div class="overview-grid">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'sliders', size: 18 }) %></span>
                <div>
                  <h3>Response policy</h3>
                  <p class="muted">How Zyron reacts when a guard confirms a threat.</p>
                </div>
              </div>
            </div>
            <div class="policy-grid">
              <div class="policy-item"><span>Anti-Nuke punishment</span><strong><%= settings.punishment %></strong></div>
              <div class="policy-item"><span>Raid punishment</span><strong><%= settings.raidPunishment %></strong></div>
              <div class="policy-item"><span>Prefix</span><strong><code><%= settings.prefix %></code></strong></div>
              <div class="policy-item"><span>Log channel</span><strong><%= settings.logChannel ? '#' + settings.logChannel : 'Auto-created' %></strong></div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" data-jump="settings">Edit response policy</button>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'sparkles', size: 18 }) %></span>
                <div>
                  <h3>Quick actions</h3>
                  <p class="muted">Jump straight into the part of the server you want to tune.</p>
                </div>
              </div>
            </div>
            <div class="quick-actions">
              <button type="button" class="quick-action" data-jump="tickets"><%- include('partials/icon', { name: 'ticket', size: 16 }) %> Design ticket panel</button>
              <button type="button" class="quick-action" data-jump="staff"><%- include('partials/icon', { name: 'user-check', size: 16 }) %> Staff application questions</button>
              <button type="button" class="quick-action" data-jump="ai"><%- include('partials/icon', { name: 'brain', size: 16 }) %> Test AI Guard</button>
              <button type="button" class="quick-action" data-jump="giveaways"><%- include('partials/icon', { name: 'gift', size: 16 }) %> Giveaway commands</button>
            </div>
          </div>
        </div>

        <div class="notice glass">
          <span class="notice-icon"><%- include('partials/icon', { name: 'shield', size: 18 }) %></span>
          <div>
            <strong>The main owner and main admin are protected.</strong>
            <p>Zyron will never automatically punish or moderate those protected IDs, even if a guard thinks they are hostile.</p>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="antinuke" id="panel-antinuke">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Protection</span>
            <h2>Anti-Nuke</h2>
            <p class="muted">Stop destructive staff actions before they become a server-wide disaster.</p>
          </div>
          <span class="badge <%= settings.antiNukeEnabled ? 'badge-success' : 'badge-muted' %>"><%= settings.antiNukeEnabled ? 'Armed' : 'Disarmed' %></span>
        </div>

        <div class="panel-grid two-one">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'shield-check', size: 18 }) %></span>
                <div>
                  <h3>Master switch</h3>
                  <p class="muted">Anti-Nuke reverts unauthorized actions and logs the evidence.</p>
                </div>
              </div>
            </div>
            <label class="switch-row">
              <span>
                <strong>Enable Anti-Nuke</strong>
                <small>Recommended for every server.</small>
              </span>
              <span class="switch"><input id="antiNukeEnabled" type="checkbox" <%= settings.antiNukeEnabled ? 'checked' : '' %>><span class="switch-track"></span></span>
            </label>
            <label class="field">
              <span>Punishment for confirmed nukers</span>
              <select class="input" id="punishment">
                <option value="ban" <%= settings.punishment === 'ban' ? 'selected' : '' %>>Ban</option>
                <option value="kick" <%= settings.punishment === 'kick' ? 'selected' : '' %>>Kick</option>
                <option value="mute" <%= settings.punishment === 'mute' ? 'selected' : '' %>>Mute</option>
              </select>
              <small class="field-hint">Every punishment includes the detected reason in the server logs.</small>
            </label>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'lock', size: 18 }) %></span>
                <div>
                  <h3>Protected by default</h3>
                  <p class="muted">Your main owner and main admin are always exempt.</p>
                </div>
              </div>
            </div>
            <div class="callout-list">
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Main owner bypass</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Main admin bypass</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Reasons attached to every action</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Private <code>#zyron-logs</code></span>
            </div>
          </div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'layers', size: 18 }) %></span>
              <div>
                <h3>Guard modules</h3>
                <p class="muted">Toggle each destructive action individually. All are included.</p>
              </div>
            </div>
            <span class="badge badge-muted"><%= securityFeatures.length %> modules</span>
          </div>
          <div class="feature-toggle-grid">
            <% securityFeatures.forEach(function (feature) { %>
              <label class="feature-toggle-row">
                <span class="feature-toggle-copy">
                  <strong><%= feature.label %></strong>
                  <small><%= feature.description %></small>
                </span>
                <span class="switch"><input class="feature-toggle" data-feature="<%= feature.key %>" type="checkbox" <%= settings.features[feature.key] ? 'checked' : '' %>><span class="switch-track"></span></span>
              </label>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="antiraid" id="panel-antiraid">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Protection</span>
            <h2>Anti-Raid</h2>
            <p class="muted">Catch join floods, lock the gates and recover what the raiders touched.</p>
          </div>
          <span class="badge <%= settings.features.antiRaid ? 'badge-success' : 'badge-muted' %>"><%= settings.features.antiRaid ? 'Watching' : 'Off' %></span>
        </div>

        <div class="panel-grid two-one">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'zap', size: 18 }) %></span>
                <div>
                  <h3>Raid response</h3>
                  <p class="muted">Choose how new raiders are handled when the join pattern is confirmed.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Raid punishment</span>
              <select class="input" id="raidPunishment">
                <option value="kick" <%= settings.raidPunishment === 'kick' ? 'selected' : '' %>>Kick (default)</option>
                <option value="ban" <%= settings.raidPunishment === 'ban' ? 'selected' : '' %>>Ban</option>
              </select>
              <small class="field-hint">Kick is the safer default. Ban is available when the raid is clearly hostile.</small>
            </label>
            <div class="callout-list">
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Join-rate detection</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Automatic lockdown</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Channel recovery after a raid</span>
            </div>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'activity', size: 18 }) %></span>
                <div>
                  <h3>Recovery</h3>
                  <p class="muted">Bring back channels and stop trusted users from betraying the server.</p>
                </div>
              </div>
            </div>
            <div class="callout-list">
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Anti-Betrayal only acts on destructive actions, never words</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Anti-Channel Recovery restores nuked channels</span>
            </div>
          </div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'shield', size: 18 }) %></span>
              <div>
                <h3>Raid & recovery modules</h3>
                <p class="muted">Keep the whole response chain enabled for the best coverage.</p>
              </div>
            </div>
          </div>
          <div class="feature-toggle-grid">
            <% recoveryFeatures.forEach(function (feature) { %>
              <label class="feature-toggle-row">
                <span class="feature-toggle-copy">
                  <strong><%= feature.label %></strong>
                  <small><%= feature.description %></small>
                </span>
                <span class="switch"><input class="feature-toggle" data-feature="<%= feature.key %>" type="checkbox" <%= settings.features[feature.key] ? 'checked' : '' %>><span class="switch-track"></span></span>
              </label>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="ai" id="panel-ai">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Intelligence</span>
            <h2>AI Guard</h2>
            <p class="muted">A second opinion before Zyron punishes. The bot still asks for confirmation before a ban or timeout.</p>
          </div>
          <span class="badge <%= settings.aiEnabled ? 'badge-success' : 'badge-muted' %>"><%= settings.aiEnabled ? 'Ready' : 'Off' %></span>
        </div>

        <div class="panel-grid two-one">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'brain', size: 18 }) %></span>
                <div>
                  <h3>AI behaviour</h3>
                  <p class="muted">Tune how confidently the AI must be before it acts.</p>
                </div>
              </div>
            </div>
            <label class="switch-row">
              <span><strong>Enable AI Guard</strong><small>Use OpenRouter for a second opinion.</small></span>
              <span class="switch"><input id="aiEnabled" type="checkbox" <%= settings.aiEnabled ? 'checked' : '' %>><span class="switch-track"></span></span>
            </label>
            <label class="switch-row">
              <span><strong>Scan chat messages</strong><small>Check abuse, threats and scams, not only nukes.</small></span>
              <span class="switch"><input id="aiScanMessages" type="checkbox" <%= settings.aiScanMessages ? 'checked' : '' %>><span class="switch-track"></span></span>
            </label>
            <label class="field">
              <span>Action preference</span>
              <select class="input" id="aiAction">
                <option value="auto" <%= settings.aiAction === 'auto' ? 'selected' : '' %>>Auto (recommended)</option>
                <option value="timeout" <%= settings.aiAction === 'timeout' ? 'selected' : '' %>>Timeout only</option>
                <option value="kick" <%= settings.aiAction === 'kick' ? 'selected' : '' %>>Kick</option>
                <option value="ban" <%= settings.aiAction === 'ban' ? 'selected' : '' %>>Ban (confirmation required)</option>
              </select>
            </label>
            <label class="field">
              <span>Model override</span>
              <input class="input" id="aiModel" type="text" maxlength="100" value="<%= settings.aiModel || '' %>" placeholder="<%= defaultModel %>">
              <small class="field-hint">Leave blank to use the dashboard default model.</small>
            </label>
            <label class="field">
              <span>Confidence threshold <strong id="aiConfidenceValue"><%= Math.round(settings.aiConfidence * 100) %>%</strong></span>
              <input id="aiConfidence" class="range" type="range" min="0.3" max="0.95" step="0.05" value="<%= settings.aiConfidence %>">
              <small class="field-hint">Higher = fewer actions, more certainty.</small>
            </label>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'sparkles', size: 18 }) %></span>
                <div>
                  <h3>AI test</h3>
                  <p class="muted">Try a message and see the verdict before a real incident.</p>
                </div>
              </div>
            </div>
            <% if (!aiReady) { %>
              <div class="inline-alert warn"><%- include('partials/icon', { name: 'alert-triangle', size: 16 }) %> Add OPENROUTER_API_KEY to the dashboard .env to test AI.</div>
            <% } %>
            <label class="field">
              <span>Sample message</span>
              <textarea class="input" id="aiTestText" rows="4" placeholder="e.g. I will leak your address if you don't send me Nitro"></textarea>
            </label>
            <button type="button" class="btn btn-primary" id="aiTestBtn"><%- include('partials/icon', { name: 'send', size: 16 }) %> Run AI test</button>
            <div id="aiTestResult" class="ai-test-result"></div>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="automod" id="panel-automod">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Chat safety</span>
            <h2>AutoMod</h2>
            <p class="muted">Keep the conversation clean without making the server feel heavily moderated.</p>
          </div>
          <span class="badge badge-muted"><%= chatFeatures.length %> filters</span>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'message-square', size: 18 }) %></span>
              <div>
                <h3>Chat filters</h3>
                <p class="muted">Minor infractions delete the message, mute for 10 minutes and warn — never ban.</p>
              </div>
            </div>
          </div>
          <div class="feature-toggle-grid">
            <% chatFeatures.forEach(function (feature) { %>
              <label class="feature-toggle-row">
                <span class="feature-toggle-copy">
                  <strong><%= feature.label %></strong>
                  <small><%= feature.description %></small>
                </span>
                <span class="switch"><input class="feature-toggle" data-feature="<%= feature.key %>" type="checkbox" <%= settings.features[feature.key] ? 'checked' : '' %>><span class="switch-track"></span></span>
              </label>
            <% }); %>
          </div>
        </div>

        <div class="notice glass">
          <span class="notice-icon"><%- include('partials/icon', { name: 'info', size: 18 }) %></span>
          <div>
            <strong>Native Discord AutoMod is separate.</strong>
            <p>If Discord’s own AutoMod should ignore the main admin, add an exempt role in Discord’s AutoMod settings. Zyron’s own handlers already protect the main admin.</p>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="tickets" id="panel-tickets">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Community</span>
            <h2>Tickets</h2>
            <p class="muted">Design the message, edit every button and publish a polished support panel.</p>
          </div>
          <span class="badge <%= settings.ticketPanelChannel ? 'badge-success' : 'badge-muted' %>"><%= settings.ticketPanelChannel ? 'Panel connected' : 'Not published' %></span>
        </div>

        <div class="stats-grid">
          <div class="stat-card glass"><span>Total tickets</span><strong><%= activity.ticketStats.total %></strong></div>
          <div class="stat-card glass"><span>Open</span><strong><%= activity.ticketStats.open %></strong></div>
          <div class="stat-card glass"><span>Closed</span><strong><%= activity.ticketStats.closed %></strong></div>
          <div class="stat-card glass"><span>Avg rating</span><strong><%= activity.ticketRatings && activity.ticketRatings.average ? activity.ticketRatings.average + '/5' : '—' %></strong></div>
          <div class="stat-card glass"><span>Pending appeals</span><strong><%= activity.appealStats.pending %></strong></div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'list', size: 18 }) %></span>
              <div>
                <h3>Ticket activity</h3>
                <p class="muted">Total tickets created and closed, including who closed them.</p>
              </div>
            </div>
          </div>
          <% if (activity.ticketStats.closedBy.length === 0) { %>
            <div class="empty-inline">No tickets have been closed yet.</div>
          <% } else { %>
            <div class="data-list">
              <% activity.ticketStats.closedBy.forEach(function (row) { %>
                <div class="data-row"><span><strong><%= row.name %></strong><small><%= row.userId %></small></span><span class="badge badge-muted"><%= row.count %> closed</span></div>
              <% }); %>
            </div>
          <% } %>
          <% if (activity.tickets.length > 0) { %>
            <div class="data-list">
              <% activity.tickets.slice(0, 8).forEach(function (ticket) { %>
                <div class="data-row">
                  <span><strong><%= ticket.type %> #<%= ticket.number %></strong><small><%= ticket.reason || 'No reason' %></small></span>
                  <span class="badge <%= ticket.status === 'open' ? 'badge-success' : 'badge-muted' %>"><%= ticket.status %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="panel-grid two-one">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'edit', size: 18 }) %></span>
                <div>
                  <h3>Panel message</h3>
                  <p class="muted">Use <code>{{buttons}}</code> where the button list should appear.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Embed title</span>
              <input class="input" id="ticketPanelTitle" type="text" maxlength="120" value="<%= settings.ticketPanelTitle %>">
            </label>
            <label class="field">
              <span>Embed description</span>
              <textarea class="input" id="ticketPanelDescription" rows="10" maxlength="4000"><%= settings.ticketPanelDescription %></textarea>
              <small class="field-hint">Leave <code>{{buttons}}</code> in the text to show the custom button list.</small>
            </label>
            <label class="field">
              <span>Footer</span>
              <input class="input" id="ticketPanelFooter" type="text" maxlength="300" value="<%= settings.ticketPanelFooter %>">
            </label>
            <div class="field-grid two">
              <label class="field">
                <span>Main button label</span>
                <input class="input" id="ticketCreateLabel" type="text" maxlength="80" value="<%= settings.ticketCreateLabel %>">
              </label>
              <label class="field">
                <span>Main button emoji</span>
                <input class="input" id="ticketCreateEmoji" type="text" maxlength="64" value="<%= settings.ticketCreateEmoji %>">
              </label>
            </div>
          </div>

          <div class="card glass preview-card">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'message-square', size: 18 }) %></span>
                <div>
                  <h3>Live preview</h3>
                  <p class="muted">A rough Discord-style preview of the panel.</p>
                </div>
              </div>
            </div>
            <div class="discord-preview">
              <div class="preview-embed" id="ticketPreviewEmbed">
                <span class="preview-accent"></span>
                <div class="preview-body">
                  <strong class="preview-title" id="ticketPreviewTitle">Ticket panel</strong>
                  <div class="preview-description" id="ticketPreviewDescription"></div>
                  <div class="preview-buttons" id="ticketPreviewButtons"></div>
                  <small class="preview-footer" id="ticketPreviewFooter"></small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'ticket', size: 18 }) %></span>
              <div>
                <h3>Custom buttons</h3>
                <p class="muted">Add up to 9 buttons. Every button asks the member for a reason before opening the ticket.</p>
              </div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="addTicketButton"><%- include('partials/icon', { name: 'plus', size: 15 }) %> Add button</button>
          </div>
          <div id="ticketButtonsEditor" class="dynamic-list"></div>
          <div class="empty-inline" id="ticketButtonsEmpty">No custom buttons yet. The default Create Ticket button still works.</div>
        </div>

        <div class="panel-grid two">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'sliders', size: 18 }) %></span>
                <div>
                  <h3>Routing</h3>
                  <p class="muted">Where the panel lives and who can see tickets.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Panel channel ID</span>
              <input class="input" id="ticketPanelChannel" type="text" maxlength="25" value="<%= settings.ticketPanelChannel || '' %>" placeholder="e.g. 1564684498661146656">
              <small class="field-hint">Used by “Publish panel”. You can also send it with <code>.ticket setup</code>.</small>
            </label>
            <label class="field">
              <span>Ticket staff role ID</span>
              <input class="input" id="ticketStaffRole" type="text" maxlength="25" value="<%= settings.ticketStaffRole || '' %>" placeholder="Role ID">
            </label>
            <label class="field">
              <span>Extra ticket staff roles</span>
              <input class="input" id="ticketStaffRoles" type="text" maxlength="300" value="<%= (settings.ticketStaffRoles || []).join(', ') %>" placeholder="Role IDs separated by commas">
              <small class="field-hint">These roles can see and manage every ticket. The accepted staff role can also be added here.</small>
            </label>
            <label class="field">
              <span>Ticket category ID</span>
              <input class="input" id="ticketCategory" type="text" maxlength="25" value="<%= settings.ticketCategory || '' %>" placeholder="Category ID">
            </label>
            <label class="field">
              <span>Channel name pattern</span>
              <input class="input" id="ticketNamePattern" type="text" maxlength="100" value="<%= settings.ticketNamePattern || 'ticket-{{ticket_number}}' %>" placeholder="name-{{ticket_number}}">
              <small class="field-hint">Supports <code>{{ticket_number}}</code>, <code>{{user}}</code>, <code>{{username}}</code> and <code>{{type}}</code>.</small>
            </label>
            <label class="field">
              <span>Ticket log channel ID</span>
              <input class="input" id="ticketLogChannel" type="text" maxlength="25" value="<%= settings.ticketLogChannel || '' %>" placeholder="Log channel ID">
            </label>
            <label class="field">
              <span>AI ticket assistant</span>
              <select class="input" id="ticketAiEnabled">
                <option value="true" <%= settings.ticketAiEnabled !== false ? 'selected' : '' %>>Enabled - reply to the first message and help the member</option>
                <option value="false" <%= settings.ticketAiEnabled === false ? 'selected' : '' %>>Disabled - staff only</option>
              </select>
            </label>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'send', size: 18 }) %></span>
                <div>
                  <h3>Publish</h3>
                  <p class="muted">Save the panel and send it to Discord in one step.</p>
                </div>
              </div>
            </div>
            <div class="callout-list">
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Sends the exact message above</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Uses the saved channel ID</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Buttons open real Zyron tickets</span>
            </div>
            <% if (!botTokenConfigured) { %>
              <div class="inline-alert warn"><%- include('partials/icon', { name: 'alert-triangle', size: 16 }) %> Add BOT_TOKEN to the dashboard .env to publish panels from the website.</div>
            <% } %>
            <button type="button" class="btn btn-primary" data-publish="ticket"><%- include('partials/icon', { name: 'send', size: 16 }) %> Save & publish panel</button>
            <small class="field-hint">You can still run <code>.ticket panel</code> in Discord at any time.</small>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="staff" id="panel-staff">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Community</span>
            <h2>Staff Applications</h2>
            <p class="muted">Build the whole hiring flow: panel, questions, review channel and accepted role.</p>
          </div>
          <span class="badge <%= settings.applicationChannel ? 'badge-success' : 'badge-muted' %>"><%= settings.applicationChannel ? 'Applications open' : 'Not configured' %></span>
        </div>

        <div class="stats-grid">
          <div class="stat-card glass"><span>Total applications</span><strong><%= activity.staffStats.total %></strong></div>
          <div class="stat-card glass"><span>Pending</span><strong><%= activity.staffStats.pending %></strong></div>
          <div class="stat-card glass"><span>Accepted</span><strong><%= activity.staffStats.accepted %></strong></div>
          <div class="stat-card glass"><span>Denied</span><strong><%= activity.staffStats.denied %></strong></div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'brain', size: 18 }) %></span>
              <div>
                <h3>Staff advice</h3>
                <p class="muted">Zyron suggests who to promote, demote, or keep. Choose a role ID before applying an action.</p>
              </div>
            </div>
          </div>
          <% if (!activity.staffAdvice || activity.staffAdvice.length === 0) { %>
            <div class="empty-inline">No staff activity yet. Advice appears after staff close tickets.</div>
          <% } else { %>
            <div class="data-list">
              <% activity.staffAdvice.forEach(function (advice) { %>
                <div class="data-row staff-advice-row">
                  <span>
                    <strong><%= advice.name %></strong>
                    <small>Advice - you can <b><%= advice.action %></b> this staff because <%= advice.reason %>. Closed: <%= advice.closes %></small>
                  </span>
                  <span class="staff-advice-actions">
                    <input class="input input-compact" id="staffRole-<%= advice.userId %>" type="text" maxlength="25" placeholder="Role ID">
                    <button type="button" class="btn btn-ghost btn-sm" data-staff-action="promote" data-staff-user="<%= advice.userId %>">Promote</button>
                    <button type="button" class="btn btn-ghost btn-sm" data-staff-action="demote" data-staff-user="<%= advice.userId %>">Demote</button>
                    <button type="button" class="btn btn-ghost btn-sm" data-staff-action="remove" data-staff-user="<%= advice.userId %>">Remove</button>
                  </span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'star', size: 18 }) %></span>
              <div>
                <h3>Staff leaderboard</h3>
                <p class="muted">Efficiency is scored from ticket closes, replies, moderation actions and appeal reviews.</p>
              </div>
            </div>
          </div>
          <% if (!activity.staffLeaderboard || activity.staffLeaderboard.length === 0) { %>
            <div class="empty-inline">No staff activity recorded yet.</div>
          <% } else { %>
            <div class="data-list">
              <% activity.staffLeaderboard.forEach(function (member, index) { %>
                <div class="data-row">
                  <span>
                    <strong>#<%= index + 1 %> &lt;@<%= member.userId %>&gt;</strong>
                    <small><%= member.ticketsClosed || 0 %> closes - <%= member.moderationActions || 0 %> mod actions - <%= member.appealsReviewed || 0 %> appeals<% if (member.avgResponseTimeMinutes !== null && member.avgResponseTimeMinutes !== undefined) { %> - avg reply <%= member.avgResponseTimeMinutes %>m<% } %></small>
                  </span>
                  <span class="badge badge-success"><%= member.efficiencyScore || 0 %> pts</span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="panel-grid two-one">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'edit', size: 18 }) %></span>
                <div>
                  <h3>Application panel</h3>
                  <p class="muted">The public message members see before they apply.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Embed title</span>
              <input class="input" id="staffApplyPanelTitle" type="text" maxlength="120" value="<%= settings.staffApplyPanelTitle %>">
            </label>
            <label class="field">
              <span>Embed description</span>
              <textarea class="input" id="staffApplyPanelDescription" rows="8" maxlength="4000"><%= settings.staffApplyPanelDescription %></textarea>
            </label>
            <label class="field">
              <span>Footer</span>
              <input class="input" id="staffApplyPanelFooter" type="text" maxlength="300" value="<%= settings.staffApplyPanelFooter %>">
            </label>
            <div class="field-grid two">
              <label class="field">
                <span>Apply button label</span>
                <input class="input" id="staffApplyButtonLabel" type="text" maxlength="80" value="<%= settings.staffApplyButtonLabel %>">
              </label>
              <label class="field">
                <span>Apply button emoji</span>
                <input class="input" id="staffApplyButtonEmoji" type="text" maxlength="64" value="<%= settings.staffApplyButtonEmoji %>">
              </label>
            </div>
            <label class="field">
              <span>Application form title</span>
              <input class="input" id="staffApplyModalTitle" type="text" maxlength="45" value="<%= settings.staffApplyModalTitle %>">
              <small class="field-hint">Shown at the top of the Discord application form.</small>
            </label>
          </div>

          <div class="card glass preview-card">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'message-square', size: 18 }) %></span>
                <div>
                  <h3>Live preview</h3>
                  <p class="muted">Panel preview plus the questions members will answer.</p>
                </div>
              </div>
            </div>
            <div class="discord-preview">
              <div class="preview-embed">
                <span class="preview-accent"></span>
                <div class="preview-body">
                  <strong class="preview-title" id="staffPreviewTitle">Staff applications</strong>
                  <div class="preview-description" id="staffPreviewDescription"></div>
                  <div class="preview-buttons" id="staffPreviewButtons"></div>
                  <small class="preview-footer" id="staffPreviewFooter"></small>
                </div>
              </div>
            </div>
            <div class="preview-form" id="staffPreviewForm"></div>
          </div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'list', size: 18 }) %></span>
              <div>
                <h3>Application questions</h3>
                <p class="muted">Discord modals allow up to 5 questions. Drag-free reordering with the arrow buttons.</p>
              </div>
            </div>
            <button type="button" class="btn btn-ghost btn-sm" id="addStaffQuestion"><%- include('partials/icon', { name: 'plus', size: 15 }) %> Add question</button>
          </div>
          <div id="staffQuestionsEditor" class="dynamic-list"></div>
        </div>

        <div class="panel-grid two">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'user-check', size: 18 }) %></span>
                <div>
                  <h3>Review & result</h3>
                  <p class="muted">Where applications arrive and what the accepted member receives.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Applications channel ID</span>
              <input class="input" id="applicationChannel" type="text" maxlength="25" value="<%= settings.applicationChannel || '' %>" placeholder="Channel ID">
            </label>
            <label class="field">
              <span>Accepted role ID</span>
              <input class="input" id="staffApplyAcceptRole" type="text" maxlength="25" value="<%= settings.staffApplyAcceptRole || '' %>" placeholder="Role ID">
              <small class="field-hint">Automatically added when a manager clicks Accept.</small>
            </label>
            <label class="field">
              <span>Extra accepted roles</span>
              <input class="input" id="staffApplyAcceptRoles" type="text" maxlength="300" value="<%= (settings.staffApplyAcceptRoles || []).join(', ') %>" placeholder="Role IDs separated by commas">
              <small class="field-hint">All of these roles are added when an application is accepted.</small>
            </label>
            <label class="field">
              <span>Appeal invite channel ID</span>
              <input class="input" id="appealInviteChannel" type="text" maxlength="25" value="<%= settings.appealInviteChannel || '' %>" placeholder="Optional channel ID">
              <small class="field-hint">Where Zyron creates the one-use invite after an appeal is approved.</small>
            </label>
            <label class="field">
              <span>Warnings before kick</span>
              <input class="input" id="warningKickThreshold" type="number" min="1" max="20" value="<%= settings.warningKickThreshold || 5 %>">
              <small class="field-hint">Spam and minor abuse are deleted and muted, then kicked at this warning count.</small>
            </label>
            <label class="field">
              <span>Accepted DM message</span>
              <textarea class="input" id="staffApplyAcceptMessage" rows="4" maxlength="1000"><%= settings.staffApplyAcceptMessage %></textarea>
              <small class="field-hint">Use <code>{server}</code> for the server name.</small>
            </label>
            <label class="field">
              <span>Denied DM message</span>
              <textarea class="input" id="staffApplyDenyMessage" rows="4" maxlength="1000"><%= settings.staffApplyDenyMessage %></textarea>
            </label>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'send', size: 18 }) %></span>
                <div>
                  <h3>Publish</h3>
                  <p class="muted">Save the panel and send it to your applications channel.</p>
                </div>
              </div>
            </div>
            <div class="callout-list">
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Custom questions appear in the modal</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Accept role is assigned automatically</span>
              <span><%- include('partials/icon', { name: 'check', size: 14 }) %> Accept / deny DMs use your text</span>
            </div>
            <% if (!botTokenConfigured) { %>
              <div class="inline-alert warn"><%- include('partials/icon', { name: 'alert-triangle', size: 16 }) %> Add BOT_TOKEN to the dashboard .env to publish panels from the website.</div>
            <% } %>
            <button type="button" class="btn btn-primary" data-publish="staff"><%- include('partials/icon', { name: 'send', size: 16 }) %> Save & publish panel</button>
            <small class="field-hint">You can still run <code>.staff-apply panel</code> in Discord at any time.</small>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="appeals" id="panel-appeals">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Moderation</span>
            <h2>Appeals</h2>
            <p class="muted">Only admins and staff with dashboard access can review these appeal cases.</p>
          </div>
          <span class="badge <%= activity.appealStats.pending > 0 ? 'badge-warning' : 'badge-success' %>"><%= activity.appealStats.pending %> pending</span>
        </div>

        <div class="stats-grid">
          <div class="stat-card glass"><span>Total appeals</span><strong><%= activity.appealStats.total %></strong></div>
          <div class="stat-card glass"><span>Pending</span><strong><%= activity.appealStats.pending %></strong></div>
          <div class="stat-card glass"><span>Approved</span><strong><%= activity.appealStats.approved %></strong></div>
          <div class="stat-card glass"><span>Declined</span><strong><%= activity.appealStats.denied %></strong></div>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'alert-triangle', size: 18 }) %></span>
              <div>
                <h3>Pending review</h3>
                <p class="muted">Approve to unban or invite the member with a one-use Zyron invite. Deny to send the opposite result.</p>
              </div>
            </div>
          </div>
          <% var pendingAppeals = activity.appeals.filter(function (appeal) { return appeal.status === 'pending'; }); %>
          <% if (pendingAppeals.length === 0) { %>
            <div class="empty-inline">No pending appeals right now.</div>
          <% } else { %>
            <div class="data-list">
              <% pendingAppeals.forEach(function (appeal) { %>
                <div class="appeal-card">
                  <div class="appeal-head">
                    <span><strong>&lt;@<%= appeal.userId %>&gt;</strong><small>Case <%= appeal.id %> | <%= appeal.actionTaken || appeal.action %> | <%= appeal.warnings || 0 %> warnings</small></span>
                    <span class="badge badge-warning">Pending</span>
                  </div>
                  <p><strong>Reason:</strong> <%= appeal.reason || 'No reason provided' %></p>
                  <% if (appeal.answers) { %>
                    <p><strong>Did they apologize?</strong> <%= appeal.answers.apology || 'Not answered' %></p>
                    <p><strong>What happened?</strong> <%= appeal.answers.whatHappened || 'Not answered' %></p>
                    <p><strong>Why approve?</strong> <%= appeal.answers.whyUnban || 'Not answered' %></p>
                  <% } else { %>
                    <p class="muted">The member has not submitted the appeal questions yet.</p>
                  <% } %>
                  <div class="appeal-actions">
                    <button type="button" class="btn btn-primary btn-sm" data-appeal-action="approve" data-case-id="<%= appeal.id %>">Approve &amp; send invite</button>
                    <button type="button" class="btn btn-ghost btn-sm" data-appeal-action="deny" data-case-id="<%= appeal.id %>">Decline appeal</button>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="card glass">
          <div class="card-head">
            <div class="card-title">
              <span class="card-icon"><%- include('partials/icon', { name: 'list', size: 18 }) %></span>
              <div>
                <h3>Recent appeal cases</h3>
                <p class="muted">Every appeal, including the staff decision and generated invite.</p>
              </div>
            </div>
          </div>
          <% if (activity.appeals.length === 0) { %>
            <div class="empty-inline">No appeal cases yet.</div>
          <% } else { %>
            <div class="data-list">
              <% activity.appeals.slice(0, 10).forEach(function (appeal) { %>
                <div class="data-row">
                  <span><strong>&lt;@<%= appeal.userId %>&gt;</strong><small><%= appeal.reason || 'No reason' %></small></span>
                  <span class="badge <%= appeal.status === 'approved' ? 'badge-success' : (appeal.status === 'denied' ? 'badge-muted' : 'badge-warning') %>"><%= appeal.status %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>

      <section class="panel" data-panel="giveaways" id="panel-giveaways">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Community</span>
            <h2>Giveaways</h2>
            <p class="muted">Reaction giveaways with start, end and reroll controls. No premium, no extra setup.</p>
          </div>
          <span class="badge badge-success">Included</span>
        </div>

        <div class="giveaway-hero glass">
          <div>
            <span class="eyebrow">Giveaway studio</span>
            <h2>Make the next drop feel special.</h2>
            <p>Run giveaways directly in Discord. Zyron tracks entries, picks winners and supports rerolls.</p>
            <a class="btn btn-primary" href="<%= brand.invite %>" target="_blank" rel="noopener">Open support server <%- include('partials/icon', { name: 'external-link', size: 14 }) %></a>
          </div>
          <div class="giveaway-orb"><%- include('partials/icon', { name: 'gift', size: 46 }) %></div>
        </div>

        <div class="command-grid">
          <div class="command-card glass">
            <span class="command-icon green"><%- include('partials/icon', { name: 'rocket', size: 18 }) %></span>
            <h3>Start</h3>
            <code>.giveaway start 10m Nitro Classic</code>
            <p>Duration accepts <code>10m</code>, <code>2h</code> or <code>1d</code>.</p>
          </div>
          <div class="command-card glass">
            <span class="command-icon amber"><%- include('partials/icon', { name: 'clock', size: 18 }) %></span>
            <h3>End early</h3>
            <code>.giveaway end &lt;messageID&gt;</code>
            <p>Pick a winner immediately instead of waiting.</p>
          </div>
          <div class="command-card glass">
            <span class="command-icon violet"><%- include('partials/icon', { name: 'refresh', size: 18 }) %></span>
            <h3>Reroll</h3>
            <code>.giveaway reroll &lt;messageID&gt;</code>
            <p>Choose a new winner from the same entries.</p>
          </div>
          <div class="command-card glass">
            <span class="command-icon blue"><%- include('partials/icon', { name: 'list', size: 18 }) %></span>
            <h3>List</h3>
            <code>.giveaway list</code>
            <p>See every active giveaway in the server.</p>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="economy" id="panel-economy">
        <div class="panel-head">
          <div>
            <span class="eyebrow">Community</span>
            <h2>Economy</h2>
            <p class="muted">Every server has its own coins, rewards and limits.</p>
          </div>
          <span class="badge badge-success">No premium</span>
        </div>

        <div class="panel-grid two">
          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'coins', size: 18 }) %></span>
                <div>
                  <h3>Daily rewards</h3>
                  <p class="muted">Coins a member receives with <code>.economy daily</code>.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Daily reward (coins)</span>
              <input class="input" id="economyDaily" type="number" min="1" max="100000" value="<%= settings.economyDaily %>">
              <small class="field-hint">Default 100. 24-hour cooldown per member.</small>
            </label>
          </div>

          <div class="card glass">
            <div class="card-head">
              <div class="card-title">
                <span class="card-icon"><%- include('partials/icon', { name: 'users', size: 18 }) %></span>
                <div>
                  <h3>Invite rewards</h3>
                  <p class="muted">Coins awarded for a real member join.</p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>Invite reward (coins)</span>
              <input class="input" id="economyInvite" type="number" min="0" max="100000" value="<%= settings.economyInvite %>">
              <small class="field-hint">Default 25. Set 0 to disable invite rewards.</small>
            </label>
          </div>
        </div>
      </section>

      <section class="panel" data-panel="modules" id="panel-modules">
        <div class="panel-head">
          <div>
