# Zyron Dashboard Configuration
# Copy this file to .env and fill in your values.

# Dashboard port (default 3000)
DASHBOARD_PORT=3000

# Secret key for sessions. Use a long random string.
SESSION_SECRET=change-this-to-a-very-long-random-string

# Set to true only when the dashboard is served over HTTPS.
DASHBOARD_SECURE_COOKIES=false

# Discord OAuth2 (required for Discord login)
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
# Fallback callback. The dashboard also derives the callback from the browser host.
# Register the exact URL shown at /auth/debug in OAuth2 -> General -> Redirects.
# localhost and 127.0.0.1 are different redirect URIs to Discord.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Main admin Discord user ID (optional, unlocks /admin)
MAIN_ADMIN_DISCORD_ID=YOUR_DISCORD_USER_ID

# Bot token. Optional, but lets the dashboard show live guild names and icons.
# Also used as a fallback for the server picker when the bot API is offline.
# Use the same token as the bot. Read-only guild lookup.
BOT_TOKEN=YOUR_BOT_TOKEN

# ---------------------------------------------------------------------------
# REMOTE BOT BRIDGE (Pterodactyl bot + Netlify website)
# ---------------------------------------------------------------------------
# Leave BOT_API_URL and BOT_API_KEY empty when the website and bot share the
# same PC and the same database.json file (local mode).
#
# When the bot runs on Pterodactyl and the website runs on Netlify, set both:
#   BOT_API_URL = public HTTPS URL of the bot API (for example
#                 https://bot-api.yourdomain.com or the Pterodactyl allocation)
#   BOT_API_KEY = the exact same long secret as BOT_API_KEY in the bot .env
#
# The dashboard will then read and write settings through the bot API instead
# of touching a local database file. The Link Test page verifies the bridge.
BOT_API_URL=
BOT_API_KEY=

# Public URL of this website. Used for the dashboard heartbeat and docs.
# Local: http://localhost:3000   Netlify: https://your-site.netlify.app
DASHBOARD_PUBLIC_URL=http://localhost:3000

# OpenRouter AI (used by the dashboard AI test button)
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODEL_2=openrouter/free
OPENROUTER_SITE_URL=https://zyranodes.com

# Optional. Absolute or relative path to the bot database.
# Default: ../bot/data/database.json in the full project layout,
# or ../data/database.json when the bot is at the package root.
# When the dashboard is hosted separately, point this at a shared database file.
# BOT_DB_PATH=C:/path/to/Zyron-Bot/bot/data/database.json
